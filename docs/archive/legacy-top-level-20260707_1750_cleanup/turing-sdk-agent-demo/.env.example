# turing-sdk-agent-demo 环境变量模板
# 复制为 .env 后填入自己的 key：cp .env.example .env
# 不要把真实 key 提交到 GitHub。

# OpenAI-compatible / GPT 系列示例
OPENAI_API_KEY="你的_openai_compatible_key"
OPENAI_BASE_URL="https://api.tap365.org/v1"
OPENAI_MODEL="gpt-5.4"

# Grok 示例
GROK_API_KEY="你的_grok_key"
GROK_BASE_URL="https://api.tap365.org/v1"
GROK_MODEL="grok-4.3"

# DeepSeek 示例
DEEPSEEK_API_KEY="你的_deepseek_key"
DEEPSEEK_BASE_URL="https://sub-lb.tap365.org"
DEEPSEEK_MODEL="deepseek-v4-pro"
