{
  "info": {
    "name": "Grok Video API"
  },
  "variable": [
    { "key": "base_url", "value": "https://chainfuel.tap365.org" },
    { "key": "api_key", "value": "" },
    { "key": "task_id", "value": "" }
  ],
  "item": [
    {
      "name": "文生视频（横屏 16:9）",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"model\": \"grok-video\",\n  \"prompt\": \"0 到 3 秒，镜头缓慢推近椅子，暖光停在椅背。\",\n  \"duration\": 3,\n  \"aspect_ratio\": \"16:9\",\n  \"resolution\": \"480p\"\n}" },
        "url": "{{base_url}}/v1/videos/generations"
      }
    },
    {
      "name": "文生视频（竖屏 9:16，不传 size）",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"model\": \"grok-video\",\n  \"prompt\": \"0 到 3 秒，镜头推近陶瓷小猫，暖光停在桌面。\",\n  \"duration\": 3,\n  \"aspect_ratio\": \"9:16\",\n  \"resolution\": \"480p\"\n}" },
        "url": "{{base_url}}/v1/videos/generations"
      }
    },
    {
      "name": "单图生视频（跟随参考图，不传 resolution/size）",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"model\": \"grok-video-1.5\",\n  \"prompt\": \"0 到 3 秒，镜头缓慢靠近，暖光停在主体上。\",\n  \"image_url\": \"https://example.com/input.png\",\n  \"duration\": 3\n}" },
        "url": "{{base_url}}/v1/videos/generations"
      }
    },
    {
      "name": "多参考图视频（reference_image_urls，最多 7 张）",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{api_key}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"model\": \"grok-image-video\",\n  \"prompt\": \"前 5 秒镜头环绕产品，中间 5 秒灯光慢慢变亮，最后 5 秒拉远，背景保持浅米色。\",\n  \"seconds\": 15,\n  \"aspect_ratio\": \"16:9\",\n  \"resolution\": \"720p\",\n  \"reference_image_urls\": [\n    \"https://example.com/ref-1.png\",\n    \"https://example.com/ref-2.png\"\n  ]\n}" },
        "url": "{{base_url}}/v1/videos/generations"
      }
    },
    {
      "name": "查询视频任务",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "url": "{{base_url}}/v1/videos/{{task_id}}"
      }
    },
    {
      "name": "下载视频内容",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{api_key}}" }],
        "url": "{{base_url}}/v1/videos/{{task_id}}/content"
      }
    }
  ]
}
